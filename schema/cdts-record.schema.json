{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cdts/schema/cdts-record.schema.json",
  "title": "Cross-Domain Trace Set record v0.1-draft",
  "description": "A correlation trace that imports references, never external conclusions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cdts_version", "trace_id", "trace_revision", "trace_scope", "source_revisions", "record_refs", "absences", "linkage_assertions", "conflicts", "unresolved", "provenance", "amendments"],
  "properties": {
    "cdts_version": {"const": "0.1-draft"},
    "trace_id": {"$ref": "#/$defs/id"},
    "trace_revision": {"type": "integer", "minimum": 1},
    "trace_scope": {"$ref": "#/$defs/traceScope"},
    "source_revisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRevision"}},
    "record_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/recordRef"}},
    "absences": {"type": "array", "items": {"$ref": "#/$defs/absence"}},
    "linkage_assertions": {"type": "array", "items": {"$ref": "#/$defs/linkageAssertion"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "amendments": {"type": "array", "items": {"$ref": "#/$defs/amendment"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "nonempty": {"type": "string", "minLength": 1, "maxLength": 1000},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "traceScope": {
      "type": "object", "additionalProperties": false,
      "required": ["scope_id", "correlation_subject", "summary", "observed_from", "observed_to", "scope_status"],
      "properties": {
        "scope_id": {"$ref": "#/$defs/id"}, "correlation_subject": {"$ref": "#/$defs/id"},
        "summary": {"$ref": "#/$defs/nonempty"}, "observed_from": {"$ref": "#/$defs/timestamp"},
        "observed_to": {"$ref": "#/$defs/timestamp"}, "scope_status": {"const": "correlation_scope"}
      }
    },
    "sourceRevision": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "repository", "revision", "role"],
      "properties": {
        "owner": {"enum": ["MPAA", "BEC", "PCA", "REVIEW_PROTOCOL", "ARB"]},
        "repository": {"type": "string", "minLength": 1, "maxLength": 300},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "role": {"enum": ["normative_source", "source_policy", "analytical_mapping"]}
      }
    },
    "recordRef": {
      "type": "object", "additionalProperties": false,
      "required": ["ref_id", "owner", "specification_revision", "record_type", "record_id", "location", "digest", "recorded_at", "link_direction", "non_import_boundary", "conclusion_imported"],
      "properties": {
        "ref_id": {"$ref": "#/$defs/id"}, "owner": {"enum": ["MPAA", "BEC", "PCA"]},
        "specification_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "record_type": {"$ref": "#/$defs/id"}, "record_id": {"$ref": "#/$defs/id"},
        "location": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"}, "digest": {"$ref": "#/$defs/digest"},
        "recorded_at": {"$ref": "#/$defs/timestamp"}, "link_direction": {"const": "external_to_cdts"},
        "non_import_boundary": {"const": "trace_reference_only"}, "conclusion_imported": {"const": false}
      }
    },
    "absence": {
      "type": "object", "additionalProperties": false,
      "required": ["absence_id", "owner", "record_type", "state", "reason"],
      "properties": {
        "absence_id": {"$ref": "#/$defs/id"}, "owner": {"enum": ["MPAA", "BEC", "PCA"]},
        "record_type": {"$ref": "#/$defs/id"},
        "state": {"enum": ["not_applicable", "not_observed", "not_produced", "unavailable", "undetermined"]},
        "reason": {"$ref": "#/$defs/nonempty"}
      }
    },
    "linkageAssertion": {
      "type": "object", "additionalProperties": false,
      "required": ["linkage_id", "from_ref", "to_ref", "relationship", "direction", "basis", "evidence_refs", "assertion_status", "asserted_by", "asserted_at"],
      "properties": {
        "linkage_id": {"$ref": "#/$defs/id"}, "from_ref": {"$ref": "#/$defs/id"}, "to_ref": {"$ref": "#/$defs/id"},
        "relationship": {"enum": ["cdts.references", "cdts.derived_from", "cdts.correlates", "cdts.has_external_reference", "cdts.has_transition_record", "cdts.has_execution_record", "cdts.precedes", "cdts.follows", "cdts.co_occurs_with", "cdts.overlaps", "cdts.temporal_order_undetermined", "cdts.does_not_imply", "cdts.conflicts_with", "cdts.partially_supports", "cdts.insufficient_for"]},
        "direction": {"enum": ["directed", "undirected"]},
        "basis": {"enum": ["cdts.explicit_reference", "cdts.content_digest", "cdts.timestamp_order", "cdts.shared_receipt", "cdts.insufficient"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "assertion_status": {"enum": ["cdts.observed", "cdts.declared", "cdts.derived", "cdts.hypothesis", "cdts.conflicting", "cdts.undetermined"]},
        "asserted_by": {"type": "string", "minLength": 1, "maxLength": 256}, "asserted_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "conflictPosition": {
      "type": "object", "additionalProperties": false, "required": ["record_ref", "position_digest"],
      "properties": {"record_ref": {"$ref": "#/$defs/id"}, "position_digest": {"$ref": "#/$defs/digest"}}
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["conflict_id", "record_refs", "native_claim_pointer", "positions", "resolution", "precedence_policy_ref"],
      "properties": {
        "conflict_id": {"$ref": "#/$defs/id"}, "record_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "native_claim_pointer": {"$ref": "#/$defs/nonempty"}, "positions": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/conflictPosition"}},
        "resolution": {"enum": ["unresolved", "selected_for_local_decision"]},
        "precedence_policy_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 500, "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"}
      }
    },
    "unresolved": {
      "type": "object", "additionalProperties": false,
      "required": ["unresolved_id", "question", "status", "required_evidence", "linkage_refs"],
      "properties": {
        "unresolved_id": {"$ref": "#/$defs/id"}, "question": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["open", "undetermined"]},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}},
        "linkage_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["produced_by", "produced_at", "producer_role", "notes"],
      "properties": {
        "produced_by": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"}, "produced_at": {"$ref": "#/$defs/timestamp"},
        "producer_role": {"const": "coordination_layer"}, "notes": {"type": "array", "items": {"type": "string", "maxLength": 1000}}
      }
    },
    "amendment": {
      "type": "object", "additionalProperties": false,
      "required": ["from_revision", "to_revision", "previous_trace_digest", "amended_at", "reason", "changed_fields"],
      "properties": {
        "from_revision": {"type": "integer", "minimum": 1}, "to_revision": {"type": "integer", "minimum": 2},
        "previous_trace_digest": {"$ref": "#/$defs/digest"}, "amended_at": {"$ref": "#/$defs/timestamp"},
        "reason": {"$ref": "#/$defs/nonempty"}, "changed_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}}
      }
    }
  }
}
